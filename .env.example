# Copy to .env and fill in. Read by NinjaOneSettings (pydantic-settings) from the
# current working directory; real environment variables take precedence.

# Your instance: https://app.ninjarmm.com (US), https://us2.ninjarmm.com,
# https://ca.ninjarmm.com, https://eu.ninjarmm.com, https://oc.ninjarmm.com
NINJA_BASE_URL=https://eu.ninjarmm.com

# An "API Services (machine-to-machine)" client app with the client_credentials grant.
NINJA_CLIENT_ID=
NINJA_CLIENT_SECRET=

# Keep this "monitoring": it is NinjaOne's read-only scope, and everything this library does is a read.
NINJA_SCOPE=monitoring

# Optional tunables.
# NINJA_TIMEOUT=30
# NINJA_MAX_ATTEMPTS=5
# NINJA_PAGE_SIZE=500

# The software snapshot (software-catalog / software-devices): where it is kept and how
# many hours it is reused before the inventory is read again.
# NINJA_CACHE_DIR=~/.cache/ninjaone
# NINJA_SNAPSHOT_MAX_AGE_HOURS=24
